# geminus 配置模板（复制为 .env.local 本地开发 / config/geminus.env 服务器部署）
# 真实值一律不入 git。

# ── 外部服务 ──
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_MODEL=deepseek-v4-flash

# MinerU 云端解析（缺失时 PDF 走内置解析器）
MINERU_API_KEY=
MINERU_API_BASE=https://mineru.net/api/v4

# ── 服务运行 ──
# 监听（生产：仅 nginx 可达的 127.0.0.1 内网端口）
# 监听地址（纯 host 时与 GEMINUS_PORT 组合；生产仅 nginx 可达的内网地址）
GEMINUS_BIND=127.0.0.1:39321
GEMINUS_PORT=39321
# 静态资源目录（前端构建产物）
GEMINUS_STATIC_DIR=app/dist
# LLM 并发请求数
GEMINUS_CONCURRENCY=3
# 翻译缓存 SQLite 路径
GEMINUS_CACHE_PATH=data/translate_cache.db

# ── 部署安全加固 ──
# 预设用户文件（PBKDF2 哈希；由 scripts/gen_users.py 生成；缺失 → 登录不可用）
GEMINUS_USERS_FILE=config/users.json
# 会话有效期（小时，默认 168 = 7 天）
GEMINUS_SESSION_TTL_HOURS=168
# HTTPS 部署时置 1（会话 Cookie 加 Secure 标记）
GEMINUS_COOKIE_SECURE=1
# ── 统一页数额度（v2.5，24 小时滚动窗口） ──
# 游客按 IP 的页数上限（识别+翻译 1 页 = 1 单位；默认 5；超额文件只处理额度内页数）
GEMINUS_ANON_PAGE_LIMIT=5
# 登录用户按用户名的页数上限（默认 1000）
GEMINUS_USER_PAGE_LIMIT=1000
# 配额 SQLite 路径（重启不重置；额度 24h 自动滚动恢复，手动清库见 deploy/README）
GEMINUS_AUTH_DB=data/auth_quota.db
# 上传落盘目录与大小上限（MB）
GEMINUS_UPLOADS_DIR=uploads
GEMINUS_MAX_UPLOAD_MB=200
# 是否允许 JSON file_path 解析服务器本地路径：本地开发置 1，生产保持 0（防任意文件读取）
GEMINUS_ALLOW_LOCAL_PATH=0
# v2.4 权限收口：查看/翻译强制登录（生产置 1；本地开发置 0 保持匿名+配额旧行为）。
# 置 1 时：匿名仍可上传（只回 doc_id 外壳，不返回 IR），GET /api/documents、
# POST /api/translate、/api/translate/paragraph、/api/original、/api/resource 一律 401。
GEMINUS_REQUIRE_LOGIN=1
# v2.4 用户文档历史库（登录用户上传/翻译记录，上限 100 条 FIFO；GET /api/history）
GEMINUS_HISTORY_DB=data/history.db
